NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hosted PostgreSQL (e.g. Neon, free). Leave empty to use the built-in local database in ./data.
# After setting it, run once: npm run db:setup
DATABASE_URL=

# Admin account, created automatically the first time the app starts (change it later in Admin > Account)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# Signs the admin session cookie. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Local database folder when DATABASE_URL is empty (default: ./data)
# DATA_DIR=./data

# Max upload size in MB (default 4, safe for serverless hosts)
# NEXT_PUBLIC_MAX_UPLOAD_MB=4

# Emails (Resend). Without a key, emails are printed in the server console.
RESEND_API_KEY=
EMAIL_FROM=eazy <noreply@yourdomain.com>
ADMIN_NOTIFY_EMAIL=you@example.com

# Reminder cron protection (Vercel cron sends this as Bearer)
CRON_SECRET=

# Optional: Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

NEXT_PUBLIC_WHATSAPP_NUMBER=212600000000
